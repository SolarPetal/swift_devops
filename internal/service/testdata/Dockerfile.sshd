# 集成测试用的 SSH + 假 systemctl + 简单 health 服务
# 跑：docker build -t swift-devops-sshd:test -f internal/service/testdata/Dockerfile.sshd internal/service/testdata
# 用：见 internal/service/pipeline_integration_test.go（build tag: integration）

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-server nginx ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd /var/log/nginx \
    && echo 'root:swift-devops-test' | chpasswd \
    && sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config \
    && sed -i 's/^UsePAM .*/UsePAM no/' /etc/ssh/sshd_config \
    && ssh-keygen -A

# fake systemctl：记录命令到日志，并对常用子命令返回合理的"测试用"输出。
# Sprint 3.6 起 deployHost 用 is-active / status，需要 stub 配合走通。
RUN cat > /usr/local/bin/systemctl <<'EOF'
#!/bin/sh
echo "[fake systemctl] $@" >> /tmp/systemctl.log
case "$1" in
  is-active)
    # 假装 unit 永远 active —— 集成测关心流程走到，不真模拟 systemd
    echo "active"
    ;;
  status)
    unit="${2:-fake.service}"
    echo "● $unit - fake systemd unit"
    echo "   Loaded: loaded (test stub)"
    echo "   Active: active (running)"
    ;;
esac
exit 0
EOF
RUN chmod +x /usr/local/bin/systemctl

# fake journalctl：deployHost 的 StatusDump 会调它，没有就 command not found
RUN cat > /usr/local/bin/journalctl <<'EOF'
#!/bin/sh
echo "[fake journalctl] $@" >> /tmp/journalctl.log
echo "(fake journalctl: no real journald in this test container)"
exit 0
EOF
RUN chmod +x /usr/local/bin/journalctl

# fake /usr/bin/java：Sprint 3.7 起 deployHost 加了 env_check 步骤会 test -x + -version
# 真装 OpenJDK 让容器膨胀几百 MB；测试场景只需要 java 路径可执行 + 输出 -version 即可
RUN cat > /usr/bin/java <<'EOF'
#!/bin/sh
case "$1" in
  -version)
    echo 'openjdk version "17.0.0" (fake stub for integration test)' >&2
    exit 0
    ;;
esac
echo "[fake java] would run: $@" >> /tmp/java.log
exit 0
EOF
RUN chmod +x /usr/bin/java

# nginx 暴露 /actuator/health，固定返回 UP，便于 health probe 通过
# 用 heredoc 避免 printf 的转义坑
RUN cat > /etc/nginx/sites-available/default <<'EOF'
server {
    listen 80 default_server;
    location /actuator/health {
        default_type application/json;
        return 200 '{"status":"UP"}';
    }
    location / { return 404; }
}
EOF

# 启动脚本：sshd 前台 + nginx 前台；任一挂了容器就退出便于排查
RUN cat > /usr/local/bin/entrypoint.sh <<'EOF'
#!/bin/bash
set -e
nginx -t
nginx
exec /usr/sbin/sshd -D -e
EOF
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 22 80

CMD ["/usr/local/bin/entrypoint.sh"]
