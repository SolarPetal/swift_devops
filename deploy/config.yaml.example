server:
  port: 8088
  mode: release           # release / debug

database:
  driver: sqlite
  dsn: ./data/swift-devops.db

security:
  # 32 字节随机 base64，丢失则历史加密数据无法解密
  master_key: "REPLACE_ME_WITH_BASE64_32B"
  jwt_secret: "REPLACE_ME_WITH_BASE64_32B"
  jwt_ttl: 24h

admin:
  username: admin
  # 用 `swift-devops hash-pwd <password>` 生成
  password_bcrypt: "$2a$10$REPLACE_ME"

storage:
  artifact_dir: ./data/artifacts
  build_workspace: ./data/build
  max_history: 30

builder:
  docker_enabled: false   # legacy 兼容字段；Maven 容器构建镜像功能已下线，当前不生效
  # maven 本地仓库 (maven_local_repo) 不在 config 里配，
  # 登录 UI 后到「系统设置 / 构建环境」页填写；留空 = 用 mvn settings.xml 里的 <localRepository>

ssh:
  pool_size_per_host: 2
  idle_timeout: 5m
  connect_timeout: 10s

monitor:
  interval: 5s
  retention: 24h

log:
  level: info
  dir: ./logs
