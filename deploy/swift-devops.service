[Unit]
Description=Swift DevOps - Java Service Automation Platform
Documentation=https://github.com/yourname/swift-devops
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__INSTALL_DIR__
ExecStart=__INSTALL_DIR__/swift-devops serve --config __CONFIG_FILE__
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
StandardOutput=append:__LOG_DIR__/stdout.log
StandardError=append:__LOG_DIR__/stderr.log

# Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=__DATA_DIR__ __LOG_DIR__

[Install]
WantedBy=multi-user.target
